# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the ESP32 must send in header x-api-key
DEVICE_API_KEY=ganti-dengan-secret-acak-yang-panjang

# Optional: secret to protect the cron endpoint (set the same value
# as "Environment Variable" cron secret in Vercel project settings)
CRON_SECRET=ganti-juga-ini

# Google Service Account (buat di Google Cloud Console > IAM > Service Accounts,
# lalu share Spreadsheet & folder Drive ke email service account ini sbg Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@xxxx.iam.gserviceaccount.com
# Private key: tempel apa adanya, ganti newline literal jadi \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_SHEET_TAB=Data
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
